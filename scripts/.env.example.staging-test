# Copy to scripts/.env.staging-test (gitignored) and fill secrets.

METTAL_STG_API_URL=https://api.v1.stg.mettal.io
METTAL_STG_ORIGIN=https://www.tkn.land
METTAL_STG_ALFIN_WEBHOOK_URL=https://intgr.stg.mettal.io/alfin/webhook

METTAL_STG_KEY=
METTAL_STG_SECRET=

# Base Sepolia wallet for mint / send (e.g. 0x0b61…2Bb0)
METTAL_STG_EVM_PRIVATE_KEY=
TKN_SENDER_PRIVATE_KEY=
TKN_RPC_URL=https://sepolia.base.org

# Fixed P2P receiver (no private key required)
TKN_RECEIVER_ADDRESS=0x8aF993d76a2f723238d38188990f801b1Fbb80D3

# Bank CCI fixture for redeem destination
METTAL_STG_BANK_CCI=03500000155325374494

METTAL_STG_DEPOSIT_AMOUNT_MAJOR=5
METTAL_STG_REDEEM_AMOUNT_MINOR=100
TKN_SEND_AMOUNT=1

# Safety gates — set to 1 to enable side effects
METTAL_STG_ALLOW_SIMULATE_DEPOSIT=0
METTAL_STG_ALLOW_ACQUIRE=0
METTAL_STG_ALLOW_REDEEM=0
METTAL_STG_ALLOW_REGISTER_DESTINATION=0
TKN_ALLOW_SEND=0
TKN_ALLOW_GAS_PACK=0
